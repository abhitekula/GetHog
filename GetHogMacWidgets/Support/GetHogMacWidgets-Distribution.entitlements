<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- What a signed, shipped widget extension carries. Selected for Release by
     project.yml; Debug takes GetHogMacWidgets.entitlements, which is this set
     minus the group. Sandbox plus exactly one membership: the team-prefixed App
     Group, which is this extension's entire view of the outside world —
     snapshot reads, and the `PendingFlagWrite` hand-off back to the app.

     `$(TeamIdentifierPrefix)group.app.gethog`, not the bare `group.app.gethog`
     the iOS extension declares: macOS requires the team prefix on an App Group
     under the App Sandbox where iOS forbids it. The Mac app's Distribution
     entitlements spell it the same way, which is the point — one container,
     one spelling, both processes.

     The same deliberate absences as the Debug file: no network client (widgets
     never call the API) and no keychain group (nothing here reads one). -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)group.app.gethog</string>
	</array>
</dict>
</plist>
