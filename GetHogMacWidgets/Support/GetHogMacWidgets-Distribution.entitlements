<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- What a signed, shipped widget extension carries. Selected for Release by
     project.yml; Debug remains deliberately unshared. The team-prefixed App
     Group and keychain group match the host, while network client access lets a
     manual or stale-timeline refresh use the shared snapshot coordinator.

     `$(TeamIdentifierPrefix)group.app.gethog`, not the bare `group.app.gethog`
     the iOS extension declares: macOS requires the team prefix on an App Group
     under the App Sandbox where iOS forbids it. The Mac app's Distribution
     entitlements spell it the same way, which is the point — one container,
     one spelling, both processes.

     Flag writes still hand off to the app because they may require device-owner
     authentication and need somewhere to report a rejected write. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)group.app.gethog</string>
	</array>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)app.gethog.shared</string>
	</array>
</dict>
</plist>
