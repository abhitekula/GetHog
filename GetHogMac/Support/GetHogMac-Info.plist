<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the generated Info.plist, the same arrangement as the iOS
     app's GetHog-Info.plist and for the same reason: INFOPLIST_KEY_* only
     understands keys Xcode has a schema for and silently drops the rest.

     Deliberately absent, not forgotten: BGTaskSchedulerPermittedIdentifiers
     and UIBackgroundModes (no BGTaskScheduler arm on macOS), the quick-action
     items (no home screen), and NSFaceIDUsageDescription (LocalAuthentication
     on macOS prompts through its own mechanism). -->
<plist version="1.0">
<dict>
	<!-- The Mac App Store shelf, and an upload requirement rather than a
	     nicety: a macOS build without this key is rejected on submission, and
	     the rejection arrives after the archive. iOS needs no counterpart —
	     its category is App Store Connect metadata, not a bundle key, which is
	     why the iOS target has never carried one. Developer tools is what a
	     PostHog client is: it reads a product's own analytics, and it sits
	     beside the API clients rather than the business dashboards. -->
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>

	<!-- Handoff ignores an activity whose type is not declared, so the
	     `.handoff` modifier advertises nothing without this. -->
	<key>NSUserActivityTypes</key>
	<array>
		<string>app.gethog.browsing</string>
	</array>

	<!-- The Team ID prefix a macOS App Group identifier must carry under the
	     App Sandbox: the container is `<TeamID>.group.app.gethog`, and only the
	     signer knows the team. `$(TeamIdentifierPrefix)` is the same
	     substitution GetHogMac-Distribution.entitlements performs on
	     `$(TeamIdentifierPrefix)group.app.gethog`, so the entitlement and
	     `SharedSnapshotStore.bundleAppGroupIdentifier` are two spellings of one
	     build setting and cannot name different containers. The widget
	     extension publishes the identical key — it is a separate bundle and
	     reads its own Info.plist.

	     Teamless builds substitute the empty string, which the kit reads as
	     "no prefix": the unprefixed identifier, no entitlement granting it, and
	     the usability probe sends this process to a private directory — the
	     honest Debug behavior a fresh clone already has. iOS bundles publish no
	     such key, and iOS ignores the prefix regardless. -->
	<key>GetHogTeamIDPrefix</key>
	<string>$(TeamIdentifierPrefix)</string>

	<!-- The inbound half of `AppModel.webURL(path:)` — same custom scheme as
	     iOS, same rationale (see GetHog-Info.plist). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>app.gethog.GetHog</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>gethog</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
