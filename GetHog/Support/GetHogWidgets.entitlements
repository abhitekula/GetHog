<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.gethog</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)app.gethog.shared</string>
	</array>
	<!-- Mirrored from the app target, not used by the extension: the kit
	     pins the two files byte-identical, and an extension that never
	     handles links simply never fires the association. See
	     GetHog/Support/GetHog.entitlements. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:$(GETHOG_OAUTH_DOMAIN)</string>
	</array>
</dict>
</plist>
